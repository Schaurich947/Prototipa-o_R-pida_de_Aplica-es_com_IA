APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
COMPANY_NAME="Acme Comércio"

# Usuário da aplicação: apenas SELECT, INSERT e UPDATE (privilégio mínimo).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=comprova
DB_USER=comprova_app
DB_PASSWORD=
# Usado somente pelo bin/setup-database.php.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Segredo compartilhado com o sistema pagador para assinar o webhook (gere um longo e aleatório).
WEBHOOK_SECRET=

# E-mail: "log" salva em storage/outbox (teste) | "mail" usa o mail() do PHP.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=nao-responda@suaempresa.com.br
MAIL_FROM_NAME="Acme Comércio"

# WhatsApp: "log" salva em storage/outbox (teste) | "cloud_api" usa a API oficial do WhatsApp Business (Meta).
WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=pagamento_efetuado
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
