APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
COMPANY_NAME="HotelFlex Direto"

# Usuário da aplicação: o setup cria com esta senha e só com SELECT, INSERT e UPDATE.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotelflex_direto
DB_USER=hotelflex_direto_app
DB_PASSWORD=
# Senha do root do MySQL (no Laragon, vazia). Usada só pelo bin/setup-database.php.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# E-mail: "log" salva em storage/outbox (teste) | "mail" usa o mail() do PHP (Laragon: Mail Sender).
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=nao-responda@hotelflex.test
MAIL_FROM_NAME="HotelFlex Direto"

# WhatsApp: "log" salva em storage/outbox (teste) | "cloud_api" usa a API oficial do WhatsApp Business (Meta).
WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=atualizacao_reserva
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
