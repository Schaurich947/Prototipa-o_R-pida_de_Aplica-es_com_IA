<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Domain</directory>
            <directory>tests/Service</directory>
            <directory>tests/Fiscal</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="date.timezone" value="America/Sao_Paulo"/>
        <!-- Expected failures logged by the code under test (e.g. simulated outages) go to a file, not the report. -->
        <ini name="error_log" value=".phpunit.cache/error.log"/>
    </php>
</phpunit>
