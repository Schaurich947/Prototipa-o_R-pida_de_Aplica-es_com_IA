APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo

# Usuário da aplicação: apenas SELECT, INSERT e UPDATE (privilégio mínimo).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotelflex
DB_USER=hotelflex_app
DB_PASSWORD=

# Usado somente pelo script bin/setup-database.php (cria tabelas e dados de demonstração).
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
